# App
APP_NAME=CarLeon API
APP_ENV=dev
API_KEY=change-me

# Database
DATABASE_URL=postgresql+psycopg://carleon:carleon@localhost:5432/carleon

# Legacy JSON chain (самописный блокчейн)
CHAIN_JSON_PATH=./data/blockchain.json

# Network node identity and statically known peers.
# For two host-run processes, use different NODE_ID/CHAIN_JSON_PATH/ports.
NODE_ID=node-a
NETWORK_ID=carleon-demo-v1
PEERS_JSON=[{"id":"node-b","url":"http://localhost:8001"}]
PEER_REQUEST_TIMEOUT_SECONDS=3